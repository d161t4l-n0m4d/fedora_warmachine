    item 4 "Status / paths"
    item 5 "Authorized-use note"
    item 0 "Back"
    echo
    read -rp "  Select: " c
    case $c in
      1)
        echo -e "  ${Y}Confirm authorized engagement? [y/N]${NC}"
        read -rp "  > " conf
        [[ "$conf" =~ ^[Yy]$ ]] || { warn "Cancelled"; sleep 1; continue; }
        launch sliver sliver || launch sliver-server sliver-server || { err "Sliver not installed (option 14)"; pause; }
        ;;
      2) launch sliver-server sliver-server || { err "missing"; pause; } ;;
      3) launch sliver-client sliver-client || { err "missing"; pause; } ;;
      4)
        echo
        echo "  PATH:"; command -v sliver; command -v sliver-server; command -v sliver-client
        echo "  WM bin:"; ls -la "${BIN_DIR}"/sliver* 2>/dev/null || echo "  (none)"
        pause
        ;;
      5)
        [[ -f "${TOOLS_DIR}/sliver/README-AUTHORIZED-USE.txt" ]] && less "${TOOLS_DIR}/sliver/README-AUTHORIZED-USE.txt" \
          || { echo "  https://sliver.sh/  https://github.com/BishopFox/sliver"; pause; }
        ;;
      0|b|B) return ;;
      *) warn "Invalid" ; sleep 0.5 ;;
    esac
  done
}

menu_files() {
  while true; do
    draw_header "Workspace folders"
    item 1 "Tools directory"
    item 2 "Wordlists"
    item 3 "Reports"
    item 4 "View install log"
    item 5 "View control log"
    item 0 "Back"
    echo
    read -rp "  Select: " c
    case $c in
      1) cd "$TOOLS_DIR" && exec bash ;;
      2) cd "$WORDLISTS_DIR" && exec bash ;;
      3) cd "$REPORTS_DIR" && exec bash ;;
      4) less "${WORKSPACE}/install.log" 2>/dev/null || { err "no install log"; pause; } ;;
      5) less "$LOGFILE" 2>/dev/null || { err "no control log"; pause; } ;;
      0|b|B) return ;;
      *) warn "Invalid" ; sleep 0.5 ;;
    esac
  done
}

start_multiplex() {
  if ! command -v tmux &>/dev/null; then
    err "tmux required:  sudo dnf install tmux"
    pause
    return
  fi
  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    info "Attaching to existing session $SESSION_NAME"
    exec tmux attach-session -t "$SESSION_NAME"
  fi

  info "Creating multiplex session…"
  tmux new-session -d -s "$SESSION_NAME" -n "Control" -c "$WORKSPACE"
  tmux split-window -h -t "$SESSION_NAME:0" -c "$TOOLS_DIR"
  tmux split-window -v -t "$SESSION_NAME:0.1" -c "$REPORTS_DIR"
  tmux new-window -t "$SESSION_NAME" -n "Recon" -c "$TOOLS_DIR"
  tmux new-window -t "$SESSION_NAME" -n "Network" -c "$WORKSPACE"
  tmux new-window -t "$SESSION_NAME" -n "Web" -c "$TOOLS_DIR"
  tmux new-window -t "$SESSION_NAME" -n "Python" -c "$WORKSPACE"
  tmux new-window -t "$SESSION_NAME" -n "Reports" -c "$REPORTS_DIR"

  if [[ -f "${VENV_DIR}/bin/activate" ]]; then
    tmux send-keys -t "$SESSION_NAME:Python" "source '${VENV_DIR}/bin/activate'; echo 'WarMachine Python ready'" C-m
  fi
  tmux select-window -t "$SESSION_NAME:0"
  tmux send-keys -t "$SESSION_NAME:0.0" "clear; echo 'WarMachine Control – run: wm-control'; echo" C-m
  tmux set-option -t "$SESSION_NAME" status-style "bg=colour235,fg=colour136"
  tmux set-option -t "$SESSION_NAME" status-left "#[fg=green,bold] WarMachine "
  tmux set-option -t "$SESSION_NAME" status-right "#[fg=cyan]#{session_name} | %H:%M "

  exec tmux attach-session -t "$SESSION_NAME"
}

# ---------- Main dashboard ----------
main_menu() {
  while true; do
    draw_header "Dashboard"
    draw_status_bar
    echo
    echo -e "  ${BOLD}${W}Operations${NC}"
    item 1 "Reconnaissance"
    item 2 "Network"
    item 3 "Enumeration"
    item 4 "Vulnerability analysis"
    item 5 "System / post-exploitation"
    item 6 "Web application"
    item 7 "Password & wordlists"
    item 8 "Wireless"
    item 9 "Forensics"
    echo
    echo -e "  ${BOLD}${W}Stacks & C2${NC}"
    item 10 "Python 3 environment"
    item 11 "Rust security tools"
    item 12 "Red Team – Sliver C2 ${Y}(auth only)${NC}"
    echo
    echo -e "  ${BOLD}${W}Workspace${NC}"
    item 13 "Folders & logs"
    item 14 "Tool inventory / status"
    item 15 "Search tools"
    item 16 "Help"
    echo
    sep
    item s "Start multiplex session (tmux)"
    item p "Python venv shell"
    item q "Quit"
    echo
    read -rp "  Select: " choice
    case $choice in
      1) menu_recon ;;
      2) menu_network ;;
      3) menu_enum ;;
      4) menu_vuln ;;
      5) menu_system ;;
      6) menu_web ;;
      7) menu_password ;;
      8) menu_wireless ;;
      9) menu_forensics ;;
      10) menu_python ;;
      11) menu_rust ;;
      12) menu_sliver ;;
      13) menu_files ;;
      14) show_status ;;
      15) search_tools ;;
      16|h|H|\?) show_help ;;
      s|S) start_multiplex ;;
      p|P)
        if activate_python; then
          exec bash --rcfile <(echo "PS1='(wm-python) \u@\h:\w\$ '")
        else
          err "venv missing"; pause
        fi
        ;;
      q|Q) echo -e "  ${G}Stay ethical.${NC}"; exit 0 ;;
      *) warn "Invalid choice"; sleep 0.4 ;;
    esac
  done
}

# ---------- Entry ----------
main() {
  ensure_workspace
  case "${1:-}" in
    start|multiplex|tmux) start_multiplex ;;
    python|py|venv)
      if activate_python; then
        exec bash --rcfile <(echo "PS1='(wm-python) \u@\h:\w\$ '")
      else
        err "venv not found"; exit 1
      fi
      ;;
    status|inventory) show_status ;;
    search) shift; search_tools "${1:-}" ;;
    help|-h|--help) show_help ;;
    menu|tui|"") main_menu ;;
    *)
      # treat unknown arg as search
      search_tools "$1"
      ;;
  esac
}

main "$@"
