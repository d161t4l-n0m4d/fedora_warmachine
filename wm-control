}

# ---------- Multiplex (tmux) session ----------
start_multiplex() {
  if ! command -v tmux &>/dev/null; then
    error "tmux is required for multiplex mode. Install with:  sudo dnf install tmux"
    sleep 2
    return
  fi

  if tmux has-session -t "$SESSION_NAME" 2>/dev/null; then
    info "Session '$SESSION_NAME' already exists. Attaching..."
    exec tmux attach-session -t "$SESSION_NAME"
  fi

  log "Creating new multiplex WarMachine session..."

  tmux new-session -d -s "$SESSION_NAME" -n "Control" -c "$WORKSPACE"

  tmux split-window -h -t "$SESSION_NAME:0" -c "$TOOLS_DIR"
  tmux split-window -v -t "$SESSION_NAME:0.1" -c "$REPORTS_DIR"

  tmux new-window -t "$SESSION_NAME" -n "Recon" -c "$TOOLS_DIR"
  tmux new-window -t "$SESSION_NAME" -n "Network" -c "$WORKSPACE"
  tmux new-window -t "$SESSION_NAME" -n "Web" -c "$TOOLS_DIR"
  tmux new-window -t "$SESSION_NAME" -n "Python" -c "$WORKSPACE"
  tmux new-window -t "$SESSION_NAME" -n "Reports" -c "$REPORTS_DIR"

  # Pre-activate Python in the Python window
  if [[ -f "${VENV_DIR}/bin/activate" ]]; then
    tmux send-keys -t "$SESSION_NAME:Python" "source ${VENV_DIR}/bin/activate && echo 'WarMachine Python venv ready'" C-m
  fi

  tmux select-window -t "$SESSION_NAME:0"
  tmux select-pane -t "$SESSION_NAME:0.0"
  tmux send-keys -t "$SESSION_NAME:0.0" "cd '$WORKSPACE' && clear && echo 'WarMachine Control – type:  wm-control   or use the panes / windows'" C-m

  tmux set-option -t "$SESSION_NAME" status-style "bg=colour235,fg=colour136"
  tmux set-option -t "$SESSION_NAME" status-left "#[fg=green,bold] WarMachine "
  tmux set-option -t "$SESSION_NAME" status-right "#[fg=cyan]#{session_name} | %H:%M "

  info "Multiplex session ready."
  echo
  echo -e "  ${BOLD}Layout:${NC}"
  echo "    Window 0  Control   – split (menu | tools | reports)"
  echo "    Window 1  Recon"
  echo "    Window 2  Network"
  echo "    Window 3  Web"
  echo "    Window 4  Python    ← WarMachine venv ready"
  echo "    Window 5  Reports"
  echo
  echo -e "  ${CYAN}Attach with:${NC}  tmux attach -t $SESSION_NAME"
  echo
  sleep 1
  exec tmux attach-session -t "$SESSION_NAME"
}

# ---------- Entry point ----------
main() {
  ensure_workspace

  case "${1:-}" in
    start|multiplex|tmux)
      start_multiplex
      ;;
    menu|tui)
      main_menu
      ;;
    python|py|venv)
      drop_into_python
      ;;
    *)
      main_menu
      ;;
  esac
}

main "$@"
