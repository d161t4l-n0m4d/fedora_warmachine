#!/usr/bin/env bash
#
# Hive SEC WarMachine – Advanced Control Interface (TUI)
#
# Usage:
#   wm-control              Main dashboard
#   wm-control start        Multiplex tmux session
#   wm-control python       Python venv shell
#   wm-control search TERM  Quick tool search
#   wm-control status       Tool inventory
#
# LEGAL: Authorized security research only. You are responsible for compliance.
#

set -uo pipefail
# note: -e omitted so missing tools don't abort the menu loop

# ---------- Paths ----------
WORKSPACE="${HOME}/WarMachine"
[[ -d /opt/WarMachine && ! -d "${HOME}/WarMachine" ]] && WORKSPACE="/opt/WarMachine"
[[ -d /opt/WarMachine && -d "${HOME}/WarMachine" ]] && WORKSPACE="${HOME}/WarMachine"

TOOLS_DIR="${WORKSPACE}/tools"
WORDLISTS_DIR="${WORKSPACE}/wordlists"
REPORTS_DIR="${WORKSPACE}/reports"
BIN_DIR="${WORKSPACE}/bin"
VENV_DIR="${WORKSPACE}/venv"
LOGFILE="${WORKSPACE}/control.log"
SESSION_NAME="WarMachine"
CARGO_BIN="${HOME}/.cargo/bin"

# ---------- Colors ----------
R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; B='\033[0;34m'
C='\033[0;36m'; M='\033[0;35m'; W='\033[1;37m'; D='\033[2m'
BOLD='\033[1m'; NC='\033[0m'
BG='\033[48;5;235m'

ok()   { echo -e "${G}✓${NC}"; }
miss() { echo -e "${D}·${NC}"; }
warn() { echo -e "${Y}!${NC} $*"; }
err()  { echo -e "${R}✗${NC} $*"; }
info() { echo -e "${C}→${NC} $*"; }
hl()   { echo -e "${BOLD}$*${NC}"; }

# ---------- Status helpers ----------
has_cmd() {
  local n="$1"
  command -v "$n" &>/dev/null && return 0
  [[ -x "${BIN_DIR}/$n" ]] && return 0
  [[ -x "${CARGO_BIN}/$n" ]] && return 0
  [[ -x "${VENV_DIR}/bin/$n" ]] && return 0
  return 1
}

mark() {
  if has_cmd "$1"; then ok; else miss; fi
}

resolve_bin() {
  local n="$1"
  if [[ -x "${BIN_DIR}/$n" ]]; then echo "${BIN_DIR}/$n"; return; fi
  if [[ -x "${CARGO_BIN}/$n" ]]; then echo "${CARGO_BIN}/$n"; return; fi
  if [[ -x "${VENV_DIR}/bin/$n" ]]; then echo "${VENV_DIR}/bin/$n"; return; fi
  if command -v "$n" &>/dev/null; then command -v "$n"; return; fi
  echo ""
}

pause() {
  echo
  read -rp "  Press Enter to continue… " _
}

ensure_workspace() {
  if [[ ! -d "$WORKSPACE" ]]; then
    err "Workspace not found: $WORKSPACE"
    echo "  Run:  sudo ./install_warmachine.sh"
    exit 1
  fi
  mkdir -p "$BIN_DIR" "$REPORTS_DIR" "$TOOLS_DIR" 2>/dev/null || true
  export PATH="${BIN_DIR}:${CARGO_BIN}:${HOME}/go/bin:${HOME}/.local/bin:${PATH}"
}

activate_python() {
  if [[ -f "${VENV_DIR}/bin/activate" ]]; then
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate"
    export PATH="${BIN_DIR}:${PATH}"
    return 0
  fi
  return 1
}

# ---------- Header / dashboard strip ----------
draw_header() {
  local title="${1:-Control Center}"
  clear
  echo -e "${B}${BOLD}"
  cat << 'EOF'
╔══════════════════════════════════════════════════════════════════╗
║            H I V E   S E C   W A R M A C H I N E                 ║
║         Advanced Control Interface  •  Ethical Use Only          ║
╚══════════════════════════════════════════════════════════════════╝
EOF
  echo -e "${NC}"
  echo -e "  ${D}workspace${NC}  ${C}${WORKSPACE}${NC}"
  echo -e "  ${D}view${NC}       ${W}${title}${NC}"
  echo -e "  ${D}$(date '+%Y-%m-%d %H:%M')${NC}"
  echo -e "${D}──────────────────────────────────────────────────────────────────${NC}"
}

draw_status_bar() {
  local py="off" rs="off" sl="off"
  [[ -d "$VENV_DIR" ]] && py="on"
  if has_cmd rustscan || has_cmd feroxbuster || has_cmd findomain; then rs="on"; fi
  if has_cmd sliver || has_cmd sliver-server || [[ -x "${BIN_DIR}/sliver-server" ]]; then sl="on"; fi

  local py_s rs_s sl_s
  [[ "$py" == on ]] && py_s="${G}Python${NC}" || py_s="${D}Python${NC}"
  [[ "$rs" == on ]] && rs_s="${G}Rust${NC}"   || rs_s="${D}Rust${NC}"
  [[ "$sl" == on ]] && sl_s="${Y}Sliver${NC}" || sl_s="${D}Sliver${NC}"

  echo -e "  stacks: ${py_s}  ${rs_s}  ${sl_s}   ${D}|${NC}  $(mark nmap) nmap  $(mark feroxbuster) ferox  $(mark sqlmap) sqlmap  $(mark msfconsole) msf"
  echo -e "${D}──────────────────────────────────────────────────────────────────${NC}"
}

# ---------- Launch ----------
# Resolve binary path only
find_bin() {
  local name="$1" cmd="${2:-$1}"
  local bin
  bin=$(resolve_bin "$cmd")
  [[ -z "$bin" ]] && bin=$(resolve_bin "$name")
  echo "$bin"
}

# Prompt for CLI arguments (user-friendly)
prompt_args() {
  local tool="$1"
  local hint="${2:-}"
  local example="${3:-}"
  echo
  echo -e "  ${BOLD}${tool}${NC}"
  [[ -n "$hint" ]] && echo -e "  ${D}${hint}${NC}"
  [[ -n "$example" ]] && echo -e "  ${D}example: ${example}${NC}"
  echo
  read -rp "  Arguments (or Enter for --help): " args
  # default to help if empty so user sees usage
  if [[ -z "${args// }" ]]; then
    echo "$args"
    return 0
  fi
  echo "$args"
}

launch() {
  local name="$1"
  local cmd="${2:-$1}"
  local extra="${3:-}"

  local bin
  bin=$(find_bin "$name" "$cmd")

  if [[ -z "$bin" ]]; then
    if [[ -d "${TOOLS_DIR}/$name" ]]; then
      info "Opening tool directory: ${TOOLS_DIR}/$name"
      cd "${TOOLS_DIR}/$name"
      activate_python || true
      if [[ -f "${name}.py" ]]; then
        exec python3 "${name}.py" $extra
      elif [[ -f main.py ]]; then
        exec python3 main.py $extra
      else
        exec bash
      fi
    fi
    err "$name not found"
    echo "  Install the matching category in:  sudo ./install_warmachine.sh"
    pause
    return 1
  fi

  info "Launching ${BOLD}${name}${NC} → $bin ${extra}"
  # shellcheck disable=SC2086
  exec "$bin" $extra
}

# Guided runners for tools that need targets
run_rustscan() {
  local bin
  bin=$(find_bin rustscan rustscan)
  if [[ -z "$bin" ]]; then
    err "rustscan not found – installer option 13"; pause; return 1
  fi
  draw_header "rustscan"
  echo -e "  ${D}Fast port scanner. Requires a target with -a${NC}"
  echo
  echo "  Common options:"
  echo "    -a <IP/CIDR/host>   addresses to scan   (required)"
  echo "    -r <range>          ports e.g. 1-1000 or 80,443"
  echo "    -ul <file>          targets from file"
  echo "    --ulimit 5000       raise open files (often needed)"
  echo
  read -rp "  Target IP / CIDR / hostname: " target
  if [[ -z "$target" ]]; then
    warn "No target – showing help"
    "$bin" --help | less
    pause
    return
  fi
  read -rp "  Port range [default: top ports / full if empty]: " ports
  read -rp "  Extra flags (e.g. --ulimit 5000 -b 500) [optional]: " extra

  local args=(-a "$target")
  [[ -n "$ports" ]] && args+=(-r "$ports")
  # shellcheck disable=SC2206
  [[ -n "$extra" ]] && args+=($extra)

  echo
  info "Command: rustscan ${args[*]}"
  echo
  # shellcheck disable=SC2086
  exec "$bin" "${args[@]}"
}

run_nmap() {
  local bin
  bin=$(find_bin nmap nmap)
  if [[ -z "$bin" ]]; then
    err "nmap not found"; pause; return 1
  fi
  draw_header "nmap"
  echo -e "  ${D}Network mapper${NC}"
  echo
  read -rp "  Target IP / host / CIDR: " target
  if [[ -z "$target" ]]; then
    "$bin" --help | less
    pause
    return
  fi
  echo "  Profiles:  1) quick (-T4 -F)  2) default  3) version (-sV)  4) full (-sC -sV)  5) custom"
  read -rp "  Profile [2]: " prof
  local args=()
  case "${prof:-2}" in
    1) args=(-T4 -F) ;;
    3) args=(-sV) ;;
    4) args=(-sC -sV) ;;
    5) read -rp "  Custom flags: " custom; # shellcheck disable=SC2206
       args=($custom) ;;
    *) args=() ;;
  esac
  info "Command: nmap ${args[*]} $target"
  exec "$bin" "${args[@]}" "$target"
}

run_feroxbuster() {
  local bin
  bin=$(find_bin feroxbuster feroxbuster)
  if [[ -z "$bin" ]]; then
    err "feroxbuster not found"; pause; return 1
  fi
  draw_header "feroxbuster"
  echo -e "  ${D}Recursive content discovery${NC}"
  echo
  read -rp "  Target URL (https://example.com): " url
  if [[ -z "$url" ]]; then
    "$bin" --help | less
    pause
    return
  fi
  local default_wl=""
  [[ -f /usr/share/wordlists/dirb/common.txt ]] && default_wl="/usr/share/wordlists/dirb/common.txt"
  [[ -f "${WORDLISTS_DIR}/SecLists/Discovery/Web-Content/common.txt" ]] && default_wl="${WORDLISTS_DIR}/SecLists/Discovery/Web-Content/common.txt"
  read -rp "  Wordlist path [${default_wl:-required}]: " wl
  wl="${wl:-$default_wl}"
  read -rp "  Extra flags (e.g. -t 50 -d 2) [optional]: " extra
  local args=(-u "$url")
  [[ -n "$wl" ]] && args+=(-w "$wl")
  # shellcheck disable=SC2206
  [[ -n "$extra" ]] && args+=($extra)
  info "Command: feroxbuster ${args[*]}"
  exec "$bin" "${args[@]}"
}

run_findomain() {
  local bin
  bin=$(find_bin findomain findomain)
  if [[ -z "$bin" ]]; then
