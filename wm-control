#!/usr/bin/env bash
#
# Hive SEC WarMachine – Multiplex Terminal Control Interface (TUI)
# Professional control center for the ethical hacking workspace
# Fully integrated with the WarMachine Python 3 venv
#
# Usage:  wm-control          (or ./wm-control)
#         wm-control start    → launch full multiplex session
#         wm-control menu     → simple category launcher
#         wm-control python   → drop into WarMachine Python shell
#
# LEGAL: Authorized use only. You are responsible for compliance with all laws.
#

set -euo pipefail

# ---------- Configuration ----------
WORKSPACE="${HOME}/WarMachine"
[[ -d /opt/WarMachine ]] && WORKSPACE="/opt/WarMachine"
TOOLS_DIR="${WORKSPACE}/tools"
WORDLISTS_DIR="${WORKSPACE}/wordlists"
REPORTS_DIR="${WORKSPACE}/reports"
BIN_DIR="${WORKSPACE}/bin"
VENV_DIR="${WORKSPACE}/venv"
LOGFILE="${WORKSPACE}/control.log"
SESSION_NAME="WarMachine"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

# ---------- Helpers ----------
log()   { echo -e "${GREEN}[+]${NC} $*" | tee -a "$LOGFILE" 2>/dev/null || echo -e "${GREEN}[+]${NC} $*"; }
warn()  { echo -e "${YELLOW}[!]${NC} $*"; }
error() { echo -e "${RED}[-]${NC} $*"; }
info()  { echo -e "${CYAN}[*]${NC} $*"; }

banner() {
  clear
  echo -e "${BLUE}${BOLD}"
  cat << 'EOF'
  _    _              __  __            _     _            
 | |  | |            |  \/  |          | |   (_)           
 | |  | | __ _ _ __  | \  / | __ _  ___| |__  _ _ __   ___ 
 | |/\| |/ _` | '__| | |\/| |/ _` |/ __| '_ \| | '_ \ / _ \
 \  /\  / (_| | |    | |  | | (_| | (__| | | | | | | |  __/
  \/  \/ \__,_|_|    |_|  |_|\__,_|\___|_| |_|_|_| |_|\___|
                                                           
  CONTROL INTERFACE  •  Multiplex Terminal TUI  •  Python3 + Rust
EOF
  echo -e "${NC}"
  echo -e "  Workspace : ${CYAN}${WORKSPACE}${NC}"
  echo -e "  Tools     : ${CYAN}${TOOLS_DIR}${NC}"
  if [[ -d "$VENV_DIR" ]]; then
    echo -e "  Python    : ${GREEN}${VENV_DIR}${NC} (active ready)"
  else
    echo -e "  Python    : ${YELLOW}venv not found – run installer option 0${NC}"
  fi
  if command -v rustscan &>/dev/null || [[ -x "${HOME}/.cargo/bin/rustscan" ]]; then
    echo -e "  Rust      : ${GREEN}~/.cargo/bin${NC} (rustscan, feroxbuster…)"
  else
    echo -e "  Rust      : ${YELLOW}not installed – run installer option 13${NC}"
  fi
  echo -e "  Session   : ${MAGENTA}${SESSION_NAME}${NC}"
  echo
}

ensure_workspace() {
  if [[ ! -d "$WORKSPACE" ]]; then
    error "WarMachine workspace not found at $WORKSPACE"
    echo "Run the installer first:  sudo ./install_warmachine.sh"
    exit 1
  fi
  mkdir -p "$BIN_DIR" "$REPORTS_DIR" 2>/dev/null || true
}

# Activate WarMachine Python environment if available
activate_python() {
  if [[ -f "${VENV_DIR}/bin/activate" ]]; then
    # shellcheck disable=SC1091
    source "${VENV_DIR}/bin/activate"
    export PATH="${BIN_DIR}:${PATH}"
    return 0
  fi
  return 1
}

# ---------- Tool launch helpers ----------
run_tool() {
  local name="$1"
  local cmd="$2"
  local dir="${3:-$TOOLS_DIR}"

  # Prefer launcher created by installer
  if [[ -x "${BIN_DIR}/${name}" ]]; then
    info "Launching $name via WarMachine launcher"
    exec "${BIN_DIR}/${name}"
  fi

  # Prefer cargo bin (Rust tools)
  if [[ -x "${HOME}/.cargo/bin/${cmd}" ]]; then
    info "Launching $name → ~/.cargo/bin/${cmd}"
    exec "${HOME}/.cargo/bin/${cmd}"
  fi
  if [[ -x "${HOME}/.cargo/bin/${name}" ]]; then
    info "Launching $name → ~/.cargo/bin/${name}"
    exec "${HOME}/.cargo/bin/${name}"
  fi

  # Prefer system binary
  if command -v "$cmd" &>/dev/null; then
    info "Launching $name → $cmd"
    exec $cmd
  fi

  # Fall back to tool directory + Python venv
  if [[ -d "$dir/$name" ]]; then
    info "Launching $name from $dir/$name"
    cd "$dir/$name"
    activate_python || true

    if [[ -f "$name.py" ]]; then
      exec python3 "$name.py" "${@:4}"
    elif [[ -f "theHarvester.py" && "$name" == "theHarvester" ]]; then
      exec python3 theHarvester.py "${@:4}"
    elif [[ -f "sqlmap.py" && "$name" == "sqlmap" ]]; then
      exec python3 sqlmap.py "${@:4}"
    elif [[ -f "dirsearch.py" && "$name" == "dirsearch" ]]; then
      exec python3 dirsearch.py "${@:4}"
    elif [[ -f "Responder.py" && "$name" == "Responder" ]]; then
      exec python3 Responder.py "${@:4}"
    elif [[ -f "vol.py" && "$name" == "volatility3" ]]; then
      exec python3 vol.py "${@:4}"
    elif [[ -f "main.py" ]]; then
      exec python3 main.py "${@:4}"
    elif [[ -x "./$name" ]]; then
      exec ./"$name" "${@:4}"
    else
      warn "Tool directory found but no clear entry point."
      echo "Opening shell inside $dir/$name (Python venv activated if available)"
      activate_python || true
      exec bash
    fi
  else
    warn "$name not found. Install the corresponding category first."
    sleep 2
  fi
}

drop_into_python() {
  banner
  if activate_python; then
    info "WarMachine Python venv activated."
    echo "Available: scapy, impacket, sqlmap, theHarvester, dirsearch, volatility3, etc."
    echo "Type 'exit' to leave."
    echo
    exec bash --rcfile <(echo "PS1='(wm-python) \u@\h:\w\$ '")
  else
    error "Python venv not found. Run the installer and choose option 0 first."
    sleep 2
  fi
}

