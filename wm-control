  fi
  read -rp "  Extra flags (e.g. -q -u url) [optional]: " extra
  local args=(-t "$domain")
  # shellcheck disable=SC2206
  [[ -n "$extra" ]] && args+=($extra)
  info "Command: findomain ${args[*]}"
  exec "$bin" "${args[@]}"
}

