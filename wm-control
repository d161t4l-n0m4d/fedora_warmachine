search_tools() {
  local q="${1:-}"
  if [[ -z "$q" ]]; then
    draw_header "Search tools"
    read -rp "  Search term: " q
  fi
  [[ -z "$q" ]] && return

  draw_header "Search: $q"
  echo
  local found=0
  # scan PATH + bins
  local list
  list=$( {
    ls "${BIN_DIR}" 2>/dev/null
    ls "${CARGO_BIN}" 2>/dev/null
    ls "${TOOLS_DIR}" 2>/dev/null
    compgen -c 2>/dev/null
  } | sort -u | grep -i "$q" | head -40 )

  if [[ -z "$list" ]]; then
    warn "No matches for '$q'"
  else
    echo "$list" | while read -r t; do
      [[ -z "$t" ]] && continue
      printf "  %-24s %s\n" "$t" "$(mark "$t")"
      found=1
    done
  fi
  echo
  read -rp "  Launch tool name (or Enter to go back): " pick
  if [[ -n "$pick" ]]; then
    launch "$pick" "$pick" || true
  fi
}

